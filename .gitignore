xcuserdata/
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint
.claude/settings.local.json
CLAUDE.local.md

# Ad-hoc pulls of the app's Documents container (see HandPoseCapture). Each dua
# capture is ~11MB of raw frames; keep the one tracked reference take below and
# leave later pulls out of history.
capture/

# The ship font is Amiri Quran (SIL OFL 1.1) and IS committed - QuranSpatial/Fonts/
# is deliberately not ignored. The KFGQPC file it replaced is licensing-unresolved and
# lives outside the build in scratch/, which is ignored.

# Durable scratch for harnesses that are not part of the build (e.g. the font
# measurement test, restored into QuranSpatialTests/ for a run and removed after).
scratch/

# The English translation (Saheeh International via Quranpedia book 1947) is held outside
# the repo until a licence or permission is documented. Local builds place the extracted
# file here; its ABSENCE is a supported state (RecitationTranslation). Never commit it.
QuranSpatial/Resources/en-*.json
# Day 4 Ask sources, named explicitly as well as by the pattern above: Jamhara (islamic-content.com)
# English entries, the Saheeh ayat the cards cite, and the Dorar English overall meaning. Local only;
# permission requested, none granted. tools/sync-public.sh refuses to run if any is tracked.
QuranSpatial/Resources/en-jamhara-terms.json
QuranSpatial/Resources/en-saheeh-1947-cited.json
QuranSpatial/Resources/en-dorar-55-overall.json
# Day 5 leads audit: the companion file carries Jamhara / translation passage TEXTS (local only).
tests/eval/day5/leads-audit-passages.csv
# The heldout-2 agent's full prompt contains the 78 ayat of the local translation; the committed
# heldout-2-prompt.md carries a marker and the block's SHA-256 instead.
tests/eval/heldout-2-prompt-full.md

# Review environment asset (67 MB): placed by hand; SHA-256 recorded in docs/baseline-disclosure.md
QuranSpatial/Resources/Environment/QuranSpatial_Review.usdz

# Swift package build products (Packages/AskCore)
.build/
.swiftpm/
